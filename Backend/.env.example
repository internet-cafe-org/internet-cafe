# =============================================================================
# Backend Environment Configuration Example (Development / Template)
# NOTE: Use dummy/fake values only. NEVER store real secrets in this file.
# =============================================================================

# Application General
APP_NAME="Internet Cafe API"
# dev | prod | test  (OPS-02: un proyecto Neon distinto por entorno)
APP_ENV="dev"
FRONTEND_BASE_URL="http://localhost:5173"

# Database Configuration
# --- Desarrollo local (docker-compose / PostgreSQL local) ---
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/internet_cafe_dev"

# --- Neon (dev y prod, OPS-02) ---
# La API usa SOLO el rol svc_app (SELECT/INSERT/UPDATE). Se acepta la URL tal como la
# entrega Neon (con sslmode / channel_binding): app/db_url.py la adapta a asyncpg.
# DATABASE_URL="postgresql://svc_app:<contraseña-de-32+-caracteres>@ep-xxxx.neon.tech/neondb?sslmode=require&channel_binding=require"
#
# Las migraciones usan el rol svc_migrator. Esta variable existe solo en CI / en el
# servicio migrador; NO se define en el servidor de la API.
# DATABASE_URL_MIGRATOR="postgresql://svc_migrator:<contraseña-de-32+-caracteres>@ep-xxxx.neon.tech/neondb?sslmode=require&channel_binding=require"
#
# Un rol por actor (ST-SEC-03, SRS §12.8). Opcionales: la que no se define usa DATABASE_URL.
# DATABASE_URL_WEB="postgresql://svc_web:<...>@ep-xxxx.neon.tech/neondb?sslmode=require"          # /auth, /me, /scan
# DATABASE_URL_MACHINE="postgresql://svc_machine:<...>@ep-xxxx.neon.tech/neondb?sslmode=require"  # /machine/*
# DATABASE_URL_ADMIN="postgresql://svc_admin:<...>@ep-xxxx.neon.tech/neondb?sslmode=require"      # /admin/*
# DATABASE_URL_JOBS="postgresql://svc_jobs:<...>@ep-xxxx.neon.tech/neondb?sslmode=require"        # barrido de inactividad
#
# Las contraseñas de los roles se pasan a db/bootstrap_roles.sql con `psql -v`
# (ver db/README.md); nunca se escriben en un archivo versionado.

# Pool de conexiones de la API y latidos
DB_POOL_SIZE=5
DB_POOL_RECYCLE_S=300
HEARTBEAT_INTERVAL_S=60
HEARTBEAT_TIMEOUT_S=180
# Tarea de inactividad (BE-09b): cada cuantos segundos revisa; false la apaga.
INACTIVIDAD_INTERVALO_S=30
TAREA_INACTIVIDAD_ACTIVA=true

# Legacy Secret Key (placeholder)
SECRET_KEY="development-only-secret-key-change-in-production-12345"

# JWT ES256 Token Configuration (SEC-00)
# Provide either relative/absolute file path or PEM-formatted string
JWT_PRIVATE_KEY="tools/keys/jwt_es256_private.pem"
JWT_PUBLIC_KEY="tools/keys/jwt_es256_public.pem"
JWT_ISSUER="internet-cafe-api"
JWT_AUDIENCE="web"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10

# Data Encryption Keys (DATA_ENC_KEYS) - Versioned AES-256-GCM key ring in JSON
# Maps key version string to 64-hex-character string (32-byte key)
DATA_ENC_KEYS='{"1": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}'

# Blind Index Key (BLIND_INDEX_KEY) - HMAC-SHA256 64-hex-character string (32 bytes)
# BLIND_INDEX_KEY=<generate-with-tools-generate_keys.py>

# Sesion web (SEC-03a)
REFRESH_TOKEN_EXPIRE_DAYS=7
# La cookie se llama __Secure-rt: el prefijo exige Secure, asi que no pongas
# COOKIE_SECURE=false (el navegador la descartaria). Chrome y Firefox aceptan
# cookies Secure en http://localhost.
COOKIE_SECURE=true
ALLOWED_ORIGIN=http://localhost:5173

# Registro (SEC-02)
# En el MVP las cuentas quedan activas sin OTP (backlog seccion 4).
REQUIRE_EMAIL_VERIFICATION=false
# Dominios de correo admitidos, separados por comas. Vacio: cualquiera (PEND-06).
ALLOWED_EMAIL_DOMAINS=

# Sesión web (SEC-03b): previews aceptados solo con APP_ENV=dev y gracia del refresh.
ORIGEN_PREVIEW_REGEX=
REFRESH_GRACIA_S=10

# Bloqueo de cuenta y rate limit (SEC-09)
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_POR_CUENTA=10
# Si una sala entera sale a internet por una sola IP (NAT), sube este valor.
RATE_LIMIT_POR_IP=10
# Saltos de proxy confiables en X-Forwarded-For: web = Vercel + Render; equipo = Render.
RATE_LIMIT_SALTOS_WEB=2
RATE_LIMIT_SALTOS_EQUIPO=1

# Firma del equipo (SEC-07): token | dual | signature
MACHINE_AUTH_MODE=dual
# Base pública con la que se arma @target-uri; en local, la URL de la API.
PUBLIC_API_BASE_URL=http://localhost:8000
FIRMA_TOLERANCIA_S=30
FIRMA_VENTANA_NONCE_S=60
# TRANSITORIO: true deja pedir QR solo con X-Machine-Code (escritorio sin actualizar).
# Se ignora con APP_ENV=prod. Apagar cuando Desktop envíe X-Machine-Key o firma.
RETOS_ACEPTAN_SOLO_CODIGO=false

# Exportación CSV (ST-BE-03)
# Zona horaria con la que se muestran las fechas en el CSV.
CSV_TIMEZONE="America/Bogota"

# Endurecimiento de la API (BE-21)
# Hosts aceptados en la cabecera Host, separados por comas. Vacío: no restringe.
ALLOWED_HOSTS=
# Tamaño máximo del cuerpo de una petición, en bytes (65536 = 64 KB).
MAX_BODY_BYTES=65536
