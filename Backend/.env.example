# =============================================================================
# Backend Environment Configuration Example (Development / Template)
# NOTE: Use dummy/fake values only. NEVER store real secrets in this file.
# =============================================================================

# Application General
APP_NAME="Internet Cafe API"
# dev | prod | test  (OPS-02: un proyecto Neon distinto por entorno)
APP_ENV="dev"
FRONTEND_BASE_URL="http://localhost:5173"

# Database Configuration
# --- Desarrollo local (docker-compose / PostgreSQL local) ---
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/internet_cafe_dev"

# --- Neon (dev y prod, OPS-02) ---
# La API usa SOLO el rol svc_app (SELECT/INSERT/UPDATE). Se acepta la URL tal como la
# entrega Neon (con sslmode / channel_binding): app/db_url.py la adapta a asyncpg.
# DATABASE_URL="postgresql://svc_app:<contraseña-de-32+-caracteres>@ep-xxxx.neon.tech/neondb?sslmode=require&channel_binding=require"
#
# Las migraciones usan el rol svc_migrator. Esta variable existe solo en CI / en el
# servicio migrador; NO se define en el servidor de la API.
# DATABASE_URL_MIGRATOR="postgresql://svc_migrator:<contraseña-de-32+-caracteres>@ep-xxxx.neon.tech/neondb?sslmode=require&channel_binding=require"
#
# Las contraseñas de los roles se pasan a db/bootstrap_roles.sql con `psql -v`
# (ver db/README.md); nunca se escriben en un archivo versionado.

# Pool de conexiones de la API y latidos
DB_POOL_SIZE=5
DB_POOL_RECYCLE_S=300
HEARTBEAT_INTERVAL_S=60
HEARTBEAT_TIMEOUT_S=180

# Legacy Secret Key (placeholder)
SECRET_KEY="development-only-secret-key-change-in-production-12345"

# JWT ES256 Token Configuration (SEC-00)
# Provide either relative/absolute file path or PEM-formatted string
JWT_PRIVATE_KEY="tools/keys/jwt_es256_private.pem"
JWT_PUBLIC_KEY="tools/keys/jwt_es256_public.pem"
JWT_ISSUER="internet-cafe-api"
JWT_AUDIENCE="web"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10

# Data Encryption Keys (DATA_ENC_KEYS) - Versioned AES-256-GCM key ring in JSON
# Maps key version string to 64-hex-character string (32-byte key)
DATA_ENC_KEYS='{"1": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}'

# Blind Index Key (BLIND_INDEX_KEY) - HMAC-SHA256 64-hex-character string (32 bytes)
# BLIND_INDEX_KEY=<generate-with-tools-generate_keys.py>

# Sesion web (SEC-03a)
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true
ALLOWED_ORIGIN=http://localhost:5173