# Copia este archivo a .env.local. NUNCA versiones secretos.
# La web habla con la API por mismo origen (rewrite /api/* de Vercel), por eso
# no hay URL de API aquí. Solo variables públicas con prefijo VITE_.

# Dominios de correo institucional permitidos en el registro, separados por coma (PEND-06).
# Vacío = solo valida el servidor.
VITE_ALLOWED_EMAIL_DOMAINS=
VITE_SUPPORT_URL=
