# Copia este archivo a .env.local. NUNCA versiones secretos.
#
# En Vercel no hace falta definir VITE_API_URL: el rewrite /api/* del vercel.json
# reenvía las peticiones al backend en Render y el cliente usa mismo origen ('').
# Solo define esta variable para apuntar a un backend diferente (ej: localhost).
VITE_API_URL=http://localhost:8000

# Dominios de correo institucional permitidos en el registro, separados por coma (PEND-06).
# Vacío = solo valida el servidor.
VITE_ALLOWED_EMAIL_DOMAINS=
VITE_SUPPORT_URL=
